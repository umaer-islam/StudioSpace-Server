# Server Configuration
PORT=5000
NODE_ENV=development # Supported: development | production | test
CLIENT_URL=http://localhost:3000 # In production, set to public Vercel frontend URL

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Better Auth Configuration (Secret must be at least 32 characters)
BETTER_AUTH_SECRET=your_minimum_32_character_secret_here
BETTER_AUTH_URL=http://localhost:5000 # In production, set to public Vercel frontend URL

# Google OAuth (Optional in dev; both required if either is supplied)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

